{
  "name": "@kyoube/bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The `kyoube` CLI: writes runtime config, installs the Kyoube plugins into the core host, and runs diagnostics",
  "files": ["dist", "package.json"],
  "scripts": {
    "build": "pnpm --filter @kyoube/license build && node build.mjs",
    "test": "pnpm --filter @kyoube/license build && vitest run",
    "typecheck": "pnpm --filter @kyoube/license build && tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@kyoube/license": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
